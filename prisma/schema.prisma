generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email        String  @unique
  hashPassword String? // 🔐 Optional: Will be null for Facebook accounts

  // Relations
  profile      Profile?
  refreshToken RefreshToken[]
}

model Profile {
  id        String   @id @default(uuid())
  firstName String
  lastName  String?
  avatarUrl String?  @db.VarChar(512)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Parent Relation mapping link block
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  hashRefreshToken String   @unique
  expiresAt        DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
