generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id         String   @id @default(uuid())
  facebookId String   @unique
  email      String?  @unique
  firstName  String
  lastName   String?
  avatarUrl  String?  @db.VarChar(512)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // 🔄 Swapped relationship to Sessions
  sessions Session[]
}

model Session {
  id        String   @id // 🔒 This will now hold the SHA-256 HASH of the random token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String // 📱 Stores the browser identity fingerprint for hijacking defense
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
